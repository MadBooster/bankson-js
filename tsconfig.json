{
  "compilerOptions": {
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "sourceMap": true,
    "inlineSources": true,
    "target": "es2022",
    "declaration": true,
    "declarationMap": true,
    "rootDir": "src",
    "outDir": "lib",
    "allowJs": false,
    "strictNullChecks": true
  },
  "include": ["src/**/*.ts"]
}
